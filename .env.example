# SAGARDRISHTI environment
# Copy to .env and fill in. NEVER commit .env.
# Account signup: docs/DATA_SOURCES.md section 6

# --- Copernicus Data Space Ecosystem (Sentinel-1) -----------------
# https://dataspace.copernicus.eu  - free, 10,000 PU/month
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Copernicus Marine (currents, waves, wind, SST, chlorophyll) --
# https://marine.copernicus.eu
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# --- ECMWF Climate Data Store (ERA5) ------------------------------
# https://cds.climate.copernicus.eu
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- NASA Earthdata (NISAR, ASF DAAC mirror) ----------------------
# https://urs.earthdata.nasa.gov
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- AISStream (live AIS) -----------------------------------------
# https://aisstream.io  - START RECORDING DAY ONE. No replay exists.
AISSTREAM_API_KEY=

# --- Database -----------------------------------------------------
POSTGRES_USER=sagar
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=sagardrishti
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sagar:change_me_locally@db:5432/sagardrishti

# --- Redis / queue ------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Storage ------------------------------------------------------
DATA_ROOT=/data
CACHE_ROOT=/data/cache
DEMO_ROOT=/data/demo

# --- Runtime ------------------------------------------------------
# 1 = cache-only. A cache miss RAISES instead of fetching.
SAGAR_OFFLINE=0
SAGAR_LOG_LEVEL=INFO
SAGAR_GSD_METRES=40

# --- Evidence signing ---------------------------------------------
EVIDENCE_SIGNING_KEY_PATH=/run/secrets/evidence_signing.pem

# --- Frontend -----------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_TILER_BASE_URL=http://localhost:8001
